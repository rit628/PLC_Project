FUN edit(x) DO
    x[1] = 0;
END

FUN edit(a,b) DO
    RETURN a + b;
END

FUN func1(z, list_len) DO
    LET i = 0;
    WHILE i < list_len DO
       print(z[i]); 
       i = i + 1;
    END
END

